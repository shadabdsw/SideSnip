{
  "manifest_version": 3,
  "name": "SideSnip",
  "version": "1.1.0",
  "homepage_url": "https://github.com/shadabdsw/sidesnip",
  "key": "",
  "description": "Keep the text and files you reuse in a glass panel at the side of your browser. Click to copy, or insert straight into any form.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Turn on / collapse SideSnip on this site",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Turn on / expand / collapse SideSnip on this site"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["styles.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sidesnip@shadabdsw",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
